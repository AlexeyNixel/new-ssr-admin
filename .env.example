NUXT_PUBLIC_API_BASE=http://localhost:3300

# Адрес публичного сайта (кнопка «На сайт» в меню, ссылки «Открыть на сайте»)
NUXT_PUBLIC_SITE_URL=https://infomania.ru

# --- ИИ-помощник редактора (нативный Ollama API) ---
# Токен и адрес видит только сервер (Nitro-прокси /api/ai/format), в браузер не попадают.
NUXT_AI_BASE_URL=https://ai.infomania.ru
NUXT_AI_TOKEN=
# Имя модели как в `ollama list` (см. /api/tags), напр. qwen3:1.7b
NUXT_AI_MODEL=qwen3:1.7b
# Модель эмбеддингов для подбора тегов по смыслу (ставится на сервере Ollama: ollama pull bge-m3)
NUXT_AI_EMBED_MODEL=bge-m3
